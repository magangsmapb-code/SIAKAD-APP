# SIAKAD Backend Environment Variables Template (Placeholders only)
PORT=4000
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

# Supabase PostgreSQL Connection (Pooler 6543 & Direct/Session 5432)
DATABASE_URL="postgresql://postgres.aymuesprbohoznguuyym:<DB_PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.aymuesprbohoznguuyym:<DB_PASSWORD>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase API & Storage Configuration (Backend Only)
SUPABASE_URL="https://aymuesprbohoznguuyym.supabase.co"
SUPABASE_ANON_KEY="<SUPABASE_ANON_OR_PUBLISHABLE_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SUPABASE_SERVICE_ROLE_OR_SECRET_KEY>"
SUPABASE_STORAGE_BUCKET="siakad-permissions"

# JWT Authentication Secrets (Generate with: openssl rand -base64 48 or crypto.randomBytes(32).toString('hex'))
# Minimum length: 32 characters with high cryptographic entropy
JWT_ACCESS_SECRET=<GENERATE_SECURE_RANDOM_ACCESS_SECRET_KEY_MIN_32_CHARS>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<GENERATE_SECURE_RANDOM_REFRESH_SECRET_KEY_MIN_32_CHARS>
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list of trusted origins)
CORS_ORIGINS=https://siakad.smapemberdayaanbangsa.sch.id,http://localhost:3000

# Rate Limiting & Throttler
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
