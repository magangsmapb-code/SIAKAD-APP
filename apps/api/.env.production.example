# ==============================================================================
# SIAKAD Backend API Production Environment Template (Placeholders Only)
# ==============================================================================
PORT=4000
NODE_ENV=production
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://siakad_admin:<GENERATE_STRONG_RANDOM_DB_PASSWORD_MIN_32_CHARS>@postgres:5432/siakad_prod_db?schema=public&sslmode=prefer"

# JWT Authentication Secrets (High Entropy 256-bit Hex Keys)
JWT_ACCESS_SECRET=<GENERATE_SECURE_RANDOM_ACCESS_SECRET_KEY_MIN_32_CHARS>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<GENERATE_SECURE_RANDOM_REFRESH_SECRET_KEY_MIN_32_CHARS>
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGINS=https://siakad.smapemberdayaanbangsa.sch.id,https://api-siakad.smapemberdayaanbangsa.sch.id

# Rate Limiting & Throttler
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
