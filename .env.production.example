# ==============================================================================
# SIAKAD Production Environment Template (Docker Compose & Deployment)
# Placeholders ONLY - NEVER commit actual production secrets to version control!
# ==============================================================================

# Domain Configuration
DOMAIN_NAME=siakad.smapemberdayaanbangsa.sch.id
API_DOMAIN_NAME=api-siakad.smapemberdayaanbangsa.sch.id
NEXT_PUBLIC_API_URL=https://api-siakad.smapemberdayaanbangsa.sch.id/api/v1

# PostgreSQL 16 Credentials (Internal Docker Network Only - Not Exposed to Internet)
POSTGRES_USER=siakad_admin
POSTGRES_PASSWORD=<GENERATE_STRONG_RANDOM_DB_PASSWORD_MIN_32_CHARS>
POSTGRES_DB=siakad_prod_db

# Backend NestJS Security Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<GENERATE_SECURE_RANDOM_ACCESS_SECRET_KEY_MIN_32_CHARS>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<GENERATE_SECURE_RANDOM_REFRESH_SECRET_KEY_MIN_32_CHARS>
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Strict comma-separated list of trusted origins)
CORS_ORIGINS=https://siakad.smapemberdayaanbangsa.sch.id,https://api-siakad.smapemberdayaanbangsa.sch.id

# Rate Limiting & Throttler (DDoS Protection)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
